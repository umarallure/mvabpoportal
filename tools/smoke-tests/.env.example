# Smoke-test configuration. Copy this file to `.env` in the same directory
# and fill in real values. `.env` is git-ignored (see .gitignore in this folder).
#
# The VS Code REST Client extension reads `{{$dotenv VAR}}` from a .env file
# located next to the .http file, and the rate-limit scripts load it too.

# Base URL of the deployed (or `vercel dev`) endpoint.
HOST=http://localhost:3000

# Raw publisher API key. Issue via the SQL recipe at the top of the migration
# (or however you've automated provisioning). Use a TEST publisher / center,
# never a production key.
API_KEY=pk_live_REPLACE_ME

# Phone numbers used by the .http scenarios. Replace each with a real number
# your DNC provider currently classifies the indicated way. Verify by calling
# the dnc-lookup edge function directly first.
SAFE_PHONE=5555550123
WARNING_PHONE=5555550199
TCPA_PHONE=5555550100

# A 2-letter US state that is NOT currently in sales_map_states with
# availability_status='unblocked'. Used by the state-coverage rejection test.
BLOCKED_STATE=AK

# How many requests rate-limit.ps1 / rate-limit.sh fire in a burst. Should be
# higher than the publisher_api_keys.rate_limit_per_minute for the test key
# so we observe 429 responses (default key cap is 20/min).
BURST_COUNT=25
