}


###
# @name warningWithConsent — hits DNC (real call!)
# Same WARNING_PHONE, this time with the structured consent payload.
# Expected: 201 accepted; audit row carries tcpa_consent jsonb.
POST {{host}}/api/leads/intake
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "submission_id": "smoke-{{$timestamp}}-warn-consent",
  "first_name": "Bob",
  "last_name": "Smith",
  "phone_number": "{{warningPhone}}",
  "email": "bob@example.com",
  "date_of_birth": "1985-01-01",
  "street_address": "1 Test Ave",
  "city": "Dallas",
  "state": "TX",
  "zip_code": "75201",
  "accident_last_12_months": true,
  "accident_date": "2026-03-01",
  "prior_attorney_involved": false,
  "other_party_admit_fault": true,
  "police_attended": true,
  "received_medical_treatment": true,
  "medical_attention": "Baylor",
  "injuries": "Whiplash",
  "insured": true,
  "vehicle_registration": "TX-1",
  "insurance_company": "GEICO",
  "third_party_vehicle_registration": "TX-2",
  "accident_scenario": "T-bone collision.",
  "source_url": "https://example.com/landing/auto-injury",
  "trustedform_cert_url": "https://cert.trustedform.com/xyz",
  "ip_address": "203.0.113.99",
  "tcpa_consent": {
    "obtained": true,
    "consent_language": "Customer verbally agreed to be contacted by the publisher and its attorney partners about their accident claim, including via automated calls and text messages, at the number provided.",
    "captured_at_iso": "2026-05-18T14:32:11Z",
    "consent_source_url": "https://example.com/landing/auto-injury"
  }
}


