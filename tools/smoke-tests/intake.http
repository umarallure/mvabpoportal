{ this is not json


###
# @name unknownField — validation-only (no DNC call)
# Exercises the .strict() guard: unknown fields cause a 400 instead of being
# silently dropped. Expected: 400 rejected_validation with issues[].
POST {{host}}/api/leads/intake
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "submission_id": "smoke-{{$timestamp}}-strict",
  "evil_field": "should be rejected",
  "first_name": "Jane",
