# POST /api/leads/intake — scenario smoke tests
#
# Setup
# -----
# 1. Install the "REST Client" extension in VS Code (humao.rest-client).
# 2. Copy .env.example → .env in this folder and fill in the values.
# 3. (Optional) `vercel dev` from the repo root to run the endpoint locally,
#    or point HOST at a Vercel preview URL.
# 4. Click "Send Request" above any ### block below.
#
# Cost note: every block that reaches the DNC step calls the real DNC
# provider, which is billed per call. The scenarios labelled
# "validation-only" / "rate-limit" intentionally fail before the DNC step.
#
# Cleanup: run cleanup.sql via Supabase Studio after a test run to wipe
# the test publisher's audit + lead rows.

@host = {{$dotenv HOST}}
@apiKey = {{$dotenv API_KEY}}
@safePhone = {{$dotenv SAFE_PHONE}}
@warningPhone = {{$dotenv WARNING_PHONE}}
@tcpaPhone = {{$dotenv TCPA_PHONE}}
@blockedState = {{$dotenv BLOCKED_STATE}}


###
# @name happyPath
# Expected: 201 { ok: true, lead_id, submission_id, dnc:{ call_status:"SAFE" } }
# Audit decision: accepted
POST {{host}}/api/leads/intake
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "submission_id": "smoke-{{$timestamp}}-happy",
  "first_name": "Jane",
  "last_name": "Doe",
  "phone_number": "{{safePhone}}",
  "email": "jane.doe@example.com",
  "date_of_birth": "1990-04-12",
  "street_address": "123 Main St",
  "city": "Austin",
  "state": "TX",
  "zip_code": "78701",
  "can_receive_texts": true,
  "accident_last_12_months": true,
  "accident_date": "2026-02-10",
  "prior_attorney_involved": false,
  "other_party_admit_fault": true,
  "police_attended": true,
  "received_medical_treatment": true,
  "medical_attention": "Seton Medical Center — ER visit + 2 follow-ups",
  "injuries": "Neck strain, lower back pain",
  "insured": true,
  "vehicle_registration": "TX-ABC-1234",
  "insurance_company": "State Farm",
  "third_party_vehicle_registration": "TX-XYZ-9876",
  "passengers_count": 0,
  "accident_scenario": "Rear-ended at red light on Congress Ave.",
  "source_url": "https://example.com/landing/auto-injury",
  "trustedform_cert_url": "https://cert.trustedform.com/abc123",
  "ip_address": "203.0.113.42"
}


###
# @name idempotentReplay
# Re-sends the SAME submission_id as happyPath would generate. To use, copy
# the submission_id from the previous response and paste it below, then click
# Send. Expected: 200 { ok:true, idempotent:true, lead_id:<same as happyPath> }
# Audit decision: accepted_idempotent
POST {{host}}/api/leads/intake
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "submission_id": "PASTE_SUBMISSION_ID_FROM_PREVIOUS_RESPONSE_HERE",
  "first_name": "Jane",
  "last_name": "Doe",
  "phone_number": "{{safePhone}}",
  "email": "jane.doe@example.com",
  "date_of_birth": "1990-04-12",
  "street_address": "123 Main St",
  "city": "Austin",
  "state": "TX",
  "zip_code": "78701",
  "accident_last_12_months": true,
  "accident_date": "2026-02-10",
  "prior_attorney_involved": false,
  "other_party_admit_fault": true,
  "police_attended": true,
  "received_medical_treatment": true,
  "medical_attention": "Seton ER",
  "injuries": "Neck strain",
  "insured": true,
  "vehicle_registration": "TX-ABC-1234",
  "insurance_company": "State Farm",
  "third_party_vehicle_registration": "TX-XYZ-9876",
  "accident_scenario": "Rear-ended.",
  "source_url": "https://example.com/x",
  "trustedform_cert_url": "https://cert.trustedform.com/abc123",
  "ip_address": "203.0.113.42"
}


