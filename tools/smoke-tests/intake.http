# @name missingAuth — validation-only (no DNC call)
# Expected: 401 { ok:false, error:{ code:"rejected_auth" } }
# Audit decision: rejected_auth (with api_key_id null)
POST {{host}}/api/leads/intake
Content-Type: application/json

{}


###
# @name bogusKey — validation-only (no DNC call)
